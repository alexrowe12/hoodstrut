{
  "name": "hoodstrut",
  "version": "0.1.0",
  "description": "Reproducible Docker benchmarks for real Claude Code configurations",
  "type": "module",
  "bin": {
    "hoodstrut": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "profiles/examples",
    "tasks/examples",
    "tasks/smoke",
    "repos/todo-app",
    "benchmarks/example-suite.yaml",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-runtime-assets.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/test-package-install.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "lint": "eslint src/ scripts/",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && npm run check:build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "benchmark",
    "claude",
    "coding-assistant",
    "ai",
    "claude-code",
    "agentic-coding",
    "evaluation",
    "docker"
  ],
  "author": "Alex Rowe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexrowe12/hoodstrut.git"
  },
  "homepage": "https://github.com/alexrowe12/hoodstrut#readme",
  "bugs": {
    "url": "https://github.com/alexrowe12/hoodstrut/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "execa": "9.6.1",
    "gray-matter": "4.0.3",
    "tmp-promise": "3.0.3",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.39.5",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
