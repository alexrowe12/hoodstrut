{
  "name": "hoodstrut",
  "version": "0.1.0",
  "description": "Benchmarking tool for LLM coding assistants",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "hoodstrut": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "profiles/examples",
    "tasks/examples",
    "tasks/smoke",
    "repos/todo-app",
    "benchmarks/example-suite.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cp -r src/docker/templates dist/docker/ && cp -r src/docker/scripts dist/docker/",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "benchmark",
    "claude",
    "coding-assistant",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "tmp-promise": "^3.0.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
